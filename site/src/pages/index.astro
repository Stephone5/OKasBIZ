---
import Base from '../layouts/Base.astro';
import StatGrid from '../components/StatGrid.astro';
import BarSet from '../components/BarSet.astro';
import SpendCounter from '../components/SpendCounter.svelte';
import { GLANCE, SPEND } from '../data/overview.js';
import { LINE_ITEMS, STAKE, POPULATION_LABEL } from '../data/stake.js';
import { BALANCE, YEAR } from '../data/books.js';
---

<Base
  title="Oklahoma Inc. — For the Okies Who Build"
  description="Oklahoma is a $213.5 billion enterprise. Every dollar you spend here is money you put into it. An open set of books for the Okies who build."
>
  <!-- ══════════════ 1 · the claim ══════════════ -->
  <section class="panel panel--hero">
    <div class="wrap panel__inner">
      <p class="brand">For the Okies who build</p>

      <h1 class="mega">
        You already<br />own a piece<br />of this state.
      </h1>

      <p class="under">Most people who built it have never seen the books.</p>

      <a class="cta" href="#receipt">
        <span>Show me</span>
        <svg width="20" height="11" viewBox="0 0 20 11" fill="none" aria-hidden="true">
          <path d="M1 1l9 8 9-8" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ══════════════ 2 · the receipt ══════════════ -->
  <section class="panel panel--tint" id="receipt">
    <div class="wrap">
      <p class="kick">Where it starts</p>

      <ul class="receipt" aria-label="Everyday spending">
        {LINE_ITEMS.map((w, i) => (
          <li class="receipt__row reveal" style={`--d:${i * 55}ms`}>
            <span class="receipt__item">{w}</span>
            <span class="receipt__leader" aria-hidden="true"></span>
            <span class="receipt__tag">money in</span>
          </li>
        ))}
      </ul>

      <p class="turn">
        Every one of these is<br /><em>money you put in.</em>
      </p>
    </div>
  </section>

  <!-- ══════════════ 3 · what that makes you ══════════════ -->
  <section class="panel panel--deep">
    <div class="wrap">
      <p class="kick kick--deep">What that makes you</p>

      <h2 class="mega mega--sm">Put money in,<br />own a piece.</h2>

      <p class="under under--deep">
        Take what the state publishes and split it across everyone who lives here.
        That is the size of the piece you already own.
      </p>

      <ul class="stake">
        {STAKE.map((s) => (
          <li class="stake__row reveal" style={`--mark:var(--series-${s.series})`}>
            <span class="stake__mark" aria-hidden="true"></span>
            <p class="stake__value tabular">{s.value}</p>
            <p class="stake__label">{s.label}</p>
            <p class="stake__working">{s.working}</p>
          </li>
        ))}
      </ul>

      <p class="source source--deep">
        Each number is a published total divided by {POPULATION_LABEL} (U.S. Census
        Bureau, Vintage 2025). Plain division, nothing guessed or filled in.
      </p>
    </div>
  </section>

  <!-- ══════════════ 4 · the books ══════════════ -->
  <section class="panel panel--open" id="books">
    <div class="wrap">
      <p class="kick">The books</p>
      <h2 class="mega mega--sm">Here is what<br />you own.</h2>

      <div class="ledgers">
        <BarSet
          caption={BALANCE.caption}
          rows={BALANCE.rows}
          source={BALANCE.source}
        />
        <BarSet
          caption={YEAR.caption}
          rows={YEAR.rows}
          source={YEAR.source}
          scale={Math.max(...BALANCE.rows.map((r) => r.value))}
        />
      </div>

      <p class="source pad-sm">
        Both sets of bars share one scale, so their lengths can be compared
        directly. Government figures are for the fiscal year ended June 30, 2024 —
        the most recent audited report.
      </p>
    </div>
  </section>

  <!-- ══════════════ 5 · the question ══════════════ -->
  <section class="panel panel--ask">
    <div class="wrap">
      <h2 class="mega mega--ask">
        So &mdash; do you like<br />how it&rsquo;s been<br /><em>invested?</em>
      </h2>
    </div>
  </section>

  <!-- ══════════════ 6 · the wider picture ══════════════ -->
  <section class="panel panel--open">
    <div class="wrap">
      <p class="kick">The wider picture</p>
      <h2 class="mega mega--sm">The rest of<br />the holdings.</h2>

      <div class="pad">
        <StatGrid stats={GLANCE} />
      </div>

      <p class="source pad-sm">
        GDP is 2025, released April 2026. Migration is Census Vintage 2025. Full
        source list at the foot of every page.
      </p>
    </div>
  </section>

  <!-- ══════════════ 7 · it is moving now ══════════════ -->
  <section class="panel panel--deep">
    <div class="wrap">
      <p class="kick kick--deep">Right now</p>
      <h2 class="mega mega--sm">The money is<br />already moving.</h2>

      <div class="pad">
        <SpendCounter perSecond={SPEND.perSecond} client:visible />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ─────────── panels ─────────── */

  .panel {
    padding-block: clamp(var(--s-8), 11vh, var(--s-10));
    position: relative;
  }

  /* Land and sky, made of colour rather than a picture: pale light at the
     top settling into warm red-dirt ground, with a horizon where they meet. */
  .panel--hero {
    min-height: min(90svh, 52rem);
    display: grid;
    align-items: center;
    background:
      linear-gradient(
        180deg,
        #fdfcfa 0%,
        #fbf8f2 42%,
        #f6ece0 74%,
        #efdfcd 100%
      );
  }

  .panel--hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent) 18%,
      var(--accent) 82%,
      transparent
    );
    opacity: 0.4;
  }

  .panel--tint { background: var(--paper-2); }
  .panel--open { background: var(--paper); }

  .panel--deep {
    background: var(--deep);
    color: var(--on-deep);
  }
  .panel--deep :is(h1, h2) { color: var(--on-deep); }

  .panel--ask {
    background: var(--accent-soft);
    padding-block: clamp(var(--s-9), 16vh, var(--s-10));
  }

  .panel__inner { display: grid; justify-items: start; }

  /* ─────────── the scan layer ─────────── */

  .brand {
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--s-6);
  }

  .kick {
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-block-end: var(--s-5);
  }
  .kick--deep { color: var(--on-deep-2); }

  /* Instrument Serif needs air. Lines were colliding at 0.94/-0.035em. */
  .mega {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8.2vw, 6.5rem);
    line-height: 1.32;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }

  .mega--sm { font-size: clamp(2.25rem, 6.2vw, 4.75rem); }

  .mega--ask {
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    max-width: 15ch;
  }
  .mega--ask em { font-style: italic; color: var(--accent); }

  .under {
    font-size: var(--t-lede);
    color: var(--ink-2);
    max-width: 38ch;
    margin-block-start: var(--s-6);
  }
  .under--deep { color: var(--on-deep-2); }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-7);
    padding: var(--s-4) var(--s-6);
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--t-body);
    font-weight: 500;
    transition: background var(--dur) var(--ease), gap var(--dur) var(--ease);
  }
  .cta:hover { background: var(--accent); gap: var(--s-5); }
  .cta svg { transition: transform var(--dur) var(--ease); }
  .cta:hover svg { transform: translateY(3px); }

  /* ─────────── the receipt ─────────── */

  .receipt {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    column-gap: var(--s-8);
    border-block-start: 1px solid var(--rule-strong);
  }

  .receipt__row {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--rule);
    transition-delay: var(--d);
  }

  .receipt__item {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .receipt__leader {
    flex: 1;
    height: 1px;
    background-image: radial-gradient(circle, var(--rule-strong) 1px, transparent 1px);
    background-size: 6px 1px;
    background-repeat: repeat-x;
    align-self: center;
    min-width: var(--s-5);
  }

  .receipt__tag {
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-4);
    white-space: nowrap;
  }

  .turn {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.2vw, 4rem);
    line-height: 1.32;
    letter-spacing: -0.008em;
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: 3px double var(--ink);
    max-width: 18ch;
  }
  .turn em { font-style: italic; color: var(--accent); }

  /* ─────────── your share ─────────── */

  .stake {
    list-style: none;
    padding: 0;
    width: 100%;
    margin-block-start: var(--s-8);
    display: grid;
    gap: 1px;
    background: var(--rule-deep);
    border-block: 1px solid var(--rule-deep);
  }

  .stake__row {
    position: relative;
    background: var(--deep);
    padding: var(--s-6) 0 var(--s-6) var(--s-5);
  }

  .stake__mark {
    position: absolute;
    inset-block: var(--s-6);
    inset-inline-start: 0;
    width: 3px;
    background: var(--mark);
  }

  .stake__value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--on-deep);
  }

  .stake__label {
    font-size: var(--t-lede);
    color: var(--on-deep-2);
    margin-block-start: var(--s-3);
    max-width: 36ch;
  }

  .stake__working {
    font-size: var(--t-small);
    color: #6f7681;
    margin-block-start: var(--s-2);
    max-width: 54ch;
    line-height: 1.55;
  }

  .source--deep { color: #6f7681; margin-block-start: var(--s-5); }

  /* ─────────── ledgers ─────────── */

  .ledgers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    gap: var(--s-8);
    margin-block-start: var(--s-7);
  }

  .pad { margin-block-start: var(--s-7); }
  .pad-sm { margin-block-start: var(--s-6); }
</style>
