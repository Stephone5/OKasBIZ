---
import { GLANCE_GROUPS } from '../data/overview.js';

interface Stat {
  value: string;
  label: string;
  meta?: string;
  group?: string;
  delta?: 'up' | 'down';
  deltaText?: string;
}

const { stats } = Astro.props as { stats: Stat[] };

const seriesOf = (key?: string) =>
  GLANCE_GROUPS.find((g) => g.key === key)?.series ?? 1;
const labelOf = (key?: string) =>
  GLANCE_GROUPS.find((g) => g.key === key)?.label ?? '';

// Only the groups actually present, in the fixed series order.
const legend = GLANCE_GROUPS.filter((g) => stats.some((s) => s.group === g.key));
---

{legend.length > 1 && (
  <ul class="legend reveal">
    {legend.map((g) => (
      <li class="legend__item">
        <span class="legend__swatch" style={`background:var(--series-${g.series})`} aria-hidden="true"></span>
        {g.label}
      </li>
    ))}
  </ul>
)}

<ul class="stats reveal">
  {stats.map((s) => (
    <li class="stat" style={`--mark:var(--series-${seriesOf(s.group)})`}>
      <span class="stat__mark" aria-hidden="true"></span>
      {s.group && <p class="stat__group">{labelOf(s.group)}</p>}
      <p class="stat__value tabular">{s.value}</p>
      <p class="stat__label">{s.label}</p>
      {s.meta && <p class="stat__meta">{s.meta}</p>}
      {s.deltaText && (
        <p class="stat__delta">
          <span aria-hidden="true">{s.delta === 'down' ? '▼' : '▲'}</span>
          <span>{s.deltaText}</span>
        </p>
      )}
    </li>
  ))}
</ul>

<style>
  .legend {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-block-end: var(--s-4);
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .legend__swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex: none;
  }

  .stats {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    grid-template-columns: repeat(auto-fit, minmax(min(11.5rem, 100%), 1fr));
  }

  .stat {
    position: relative;
    background: var(--surface);
    padding: var(--s-4) var(--s-4) var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    transition: background var(--dur) var(--ease);
  }

  .stat:hover { background: var(--paper); }

  /* The one place series colour appears on a tile. It marks the group,
     which is the only thing the colour means. */
  .stat__mark {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 3px;
    background: var(--mark);
  }

  .stat__group {
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-4);
    margin-block-end: var(--s-1);
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-tight);
  }

  .stat__label {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink);
    margin-block-start: var(--s-2);
  }

  .stat__meta,
  .stat__delta {
    font-size: var(--t-micro);
    color: var(--ink-3);
    line-height: 1.4;
  }

  /* Deliberately uncoloured. An arrow and a word, so no figure is
     implied to be good or bad by its colour. */
  .stat__delta {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    margin-block-start: auto;
    padding-block-start: var(--s-2);
  }

  /* On the inverted band the tiles invert with it. */
  :global(.section--deep) .stats { background: var(--rule-deep); border-color: var(--rule-deep); }
  :global(.section--deep) .stat { background: var(--deep-2); }
  :global(.section--deep) .stat:hover { background: #23272e; }
  :global(.section--deep) .stat__value,
  :global(.section--deep) .stat__label { color: var(--on-deep); }
  :global(.section--deep) .stat__meta,
  :global(.section--deep) .stat__delta,
  :global(.section--deep) .stat__group { color: var(--on-deep-2); }
</style>
