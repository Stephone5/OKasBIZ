---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import StatGrid from '../components/StatGrid.astro';
import CompareTable from '../components/CompareTable.astro';
import Action from '../components/Action.astro';
import SpendCounter from '../components/SpendCounter.svelte';
import { GLANCE, VS_US, VS_US_NOTE, SPEND } from '../data/overview.js';
---

<Base
  title="Oklahoma Inc. — A Financial Portrait of the Sooner State"
  description="An integrated financial and economic atlas of the State of Oklahoma, compiled from public data and presented without editorial conclusions."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow hero__eyebrow">A financial portrait of the state</p>
      <h1 class="hero__title">
        Oklahoma is a <span class="hero__figure">$213&nbsp;billion</span> enterprise.
      </h1>
      <p class="hero__sub">
        Most of the people who built it have never seen the books.
      </p>
      <a class="hero__cta" href="#glance">See what you own</a>
    </div>
  </section>

  <section class="section" id="glance">
    <div class="wrap">
      <SectionHead
        eyebrow="Section 01"
        title="Oklahoma at a glance"
        lede="Two sets of books. The government — a low-debt, oil-levered public enterprise with a growing net worth. And the economy — a $213-billion machine still pumping crude, rebuilt over time on aerospace, wind, and tribal enterprise."
      />

      <div class="pad">
        <StatGrid stats={GLANCE} />
      </div>

      <p class="source pad-sm">
        Government figures are for the fiscal year ended June 30, 2024 — the most recent
        audited report. GDP is 2025, released April 2026. Migration is Census Vintage 2025.
        Full source list at the foot of every page.
      </p>

      <Action>
        Look up one fact about your county&rsquo;s economy this week. Just one. Search
        your county name and &ldquo;Oklahoma economy&rdquo; and read for five minutes.
      </Action>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        eyebrow="Section 02"
        title="Oklahoma against the United States"
        lede="Every row is a strict one-to-one: the same metric, the same year, the same source. The only thing that changes is the geography."
      />

      <CompareTable rows={VS_US} />

      <p class="source pad-sm">{VS_US_NOTE}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        eyebrow="Live estimate"
        title="Oklahoma spends while you read"
        lede={SPEND.note}
      />

      <div class="pad">
        <SpendCounter perSecond={SPEND.perSecond} client:visible />
      </div>

      <p class="source pad-sm">Source: {SPEND.source}.</p>

      <Action>
        Track where your last ten purchases went. Locally owned, or not. Just notice.
      </Action>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(var(--s-8), 14vh, var(--s-10));
    border-block-end: 1px solid var(--rule);
  }

  .hero__eyebrow { margin-block-end: var(--s-5); }

  .hero__title {
    font-size: var(--t-h1);
    max-width: 18ch;
    line-height: var(--lh-tight);
  }

  .hero__figure { font-style: italic; }

  .hero__sub {
    font-size: var(--t-lede);
    color: var(--ink-2);
    max-width: 34ch;
    margin-block-start: var(--s-5);
  }

  .hero__cta {
    display: inline-block;
    margin-block-start: var(--s-7);
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: var(--t-small);
    font-weight: 500;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .hero__cta:hover { background: var(--ink); color: var(--paper); }

  .pad { margin-block-start: var(--s-6); }
  .pad-sm { margin-block-start: var(--s-4); }
</style>
