---
import Base from '../layouts/Base.astro';
import StatGrid from '../components/StatGrid.astro';
import BarSet from '../components/BarSet.astro';
import SpendCounter from '../components/SpendCounter.svelte';
import SplitText from '../components/SplitText.astro';
import Ticker from '../components/Ticker.astro';
import { TICKER_SOURCES } from '../data/sources.js';
import CountUp from '../components/CountUp.svelte';
import BudgetGuess from '../components/BudgetGuess.svelte';
import { GLANCE, SPEND } from '../data/overview.js';
import { LINE_ITEMS, LINE_ITEMS_SOURCE, STAKE, POPULATION_LABEL } from '../data/stake.js';
import { BALANCE, YEAR } from '../data/books.js';
---

<Base
  title="Oklahoma Inc. — For the Okies Who Build"
  description="Oklahoma is a $213.5 billion enterprise. Every dollar you spend here is money you put into it. An open set of books for the Okies who build."
  sources={['acfr','budget','economy','population','tribal','jobs','households','health','justice']}
  notes={[
    { title: 'On the per-person figures', text: 'Each is a published total divided by the Census Vintage 2025 population of Oklahoma, 4,123,288. Plain division — nothing modelled, nothing weighted.' },
    { title: 'On the spending estimate', text: 'The live counter divides an annual personal-consumption figure down to a per-second rate and resets each 60-second cycle. It illustrates a rate. It is not a measurement of money moving in real time.' },
    { title: 'On the budget question', text: 'The figures behind it are FY2026 appropriations: education $5.76B, health and social services $2.32B, everything else $4.00B, of $12.08B total. Your answer is not stored, scored or sent anywhere.' },
  ]}
  image="/hero.jpg"
  imageAlt="Oklahoma landscape"
>
  <!-- ══════════ 1 · the claim ══════════ -->
  <section class="panel panel--hero">
    <div class="wrap panel__inner">
      <p class="brand">For the Okies who build</p>
      <SplitText as="h1" class="mega" text="You already / own a piece / of this state." />
      <p class="under">Most people who built it have never seen the books.</p>
    </div>

    <div class="hero__band">
      <Ticker items={TICKER_SOURCES} />
    </div>
  </section>

  <!-- ══════════ 2 · empathy ══════════ -->
  <section class="panel panel--tight">
    <div class="wrap">
      <SplitText class="mega mega--sm" text="Nobody hands / you the books." />
      <p class="under">
        The numbers are public. They sit in audited reports that run to hundreds of
        pages, written for accountants, and almost nobody reads them. That is the
        only reason any of this is hard to find.
      </p>
    </div>
  </section>

  <!-- ══════════ 3 · the receipt ══════════ -->
  <section class="panel panel--tint" id="receipt">
    <div class="wrap">
      <h2 class="mega mega--sm">Where it starts</h2>

      <ul class="receipt" aria-label="Everyday prices in Oklahoma">
        {LINE_ITEMS.map((it, n) => (
          <li class="receipt__row reveal" style={`--d:${n * 55}ms`}>
            <span class="receipt__item">{it.item}</span>
            <span class="receipt__leader" aria-hidden="true"></span>
            <span class="receipt__price tabular">{it.price}</span>
            <span class="receipt__unit">{it.unit}<span class="receipt__where">{it.where}</span></span>
          </li>
        ))}
      </ul>

      <p class="turn">Every one of these is<br /><em>money you put in.</em></p>
      <p class="source pad-sm">{LINE_ITEMS_SOURCE}</p>
    </div>
  </section>

  <!-- ══════════ 4 · your share ══════════ -->
  <section class="panel panel--deep">
    <div class="wrap">
      <div class="pinwrap">
        <div class="pinwrap__side">
          <SplitText class="mega mega--sm" text="Put money in, / own a piece." />
          <p class="under under--deep">
            Take what the state publishes and split it across everyone who lives here.
            That is the size of the piece you already own.
          </p>
        </div>

        <div class="pinwrap__flow">
      <ul class="stake stake--flow">
        {STAKE.map((s) => (
          <li class="stake__row reveal" style={`--mark:var(--series-${s.series})`}>
            <span class="stake__mark" aria-hidden="true"></span>
            <p class="stake__value tabular"><CountUp value={s.n} prefix={s.prefix} client:visible /></p>
            <p class="stake__label">{s.label}</p>
            <p class="stake__working">{s.working}</p>
          </li>
        ))}
      </ul>

      <p class="source source--deep">
        Each number is a published total divided by {POPULATION_LABEL} (U.S. Census
        Bureau, Vintage 2025). Plain division, nothing guessed or filled in.
      </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 5 · the books ══════════ -->
  <section class="panel panel--open" id="books">
    <div class="wrap">
      <SplitText class="mega mega--sm" text="Here is what / you own." />

      <div class="ledgers">
        <BarSet caption={BALANCE.caption} rows={BALANCE.rows} source={BALANCE.source} />
        <BarSet
          caption={YEAR.caption}
          rows={YEAR.rows}
          source={YEAR.source}
          scale={Math.max(...BALANCE.rows.map((r) => r.value))}
        />
      </div>

      <p class="source pad-sm">
        Both sets of bars share one scale, so their lengths can be compared directly.
        Government figures are for the fiscal year ended June 30, 2024 — the most
        recent audited report.
      </p>
    </div>
  </section>

  <!-- ══════════ 6 · guess, then see ══════════ -->
  <section class="panel panel--ask">
    <div class="wrap">
      <BudgetGuess client:load />

      <h2 class="mega mega--ask">
        So &mdash; do you like<br />how it&rsquo;s been<br /><em>invested?</em>
      </h2>
    </div>
  </section>

  <!-- ══════════ 7 · authority ══════════ -->
  <section class="panel panel--tight">
    <div class="wrap">
      <h2 class="mega mega--sm">Nothing here<br />is invented.</h2>

      <ul class="auth">
        <li><strong>The state&rsquo;s own audited annual report</strong> for what it owns, owes and spends</li>
        <li><strong>The U.S. Census Bureau</strong> for population and migration</li>
        <li><strong>The Bureau of Economic Analysis</strong> for the size of the economy</li>
        <li><strong>The Bureau of Labor Statistics</strong> for work and wages</li>
      </ul>

      <p class="under">
        Nothing is modelled, estimated, or filled in. Where a figure was never
        published, this site says so rather than guessing at it.
      </p>
    </div>
  </section>

  <!-- ══════════ 8 · the rest ══════════ -->
  <section class="panel panel--tint">
    <div class="wrap">
      <SplitText class="mega mega--sm" text="The rest of / the holdings." />

      <div class="pad"><StatGrid stats={GLANCE} /></div>

      <p class="source pad-sm">
        GDP is 2025, released April 2026. Migration is Census Vintage 2025. Full
        source list at the foot of every page.
      </p>
    </div>
  </section>

  <!-- ══════════ 9 · moving now ══════════ -->
  <section class="panel panel--deep">
    <div class="wrap">
      <SplitText class="mega mega--sm" text="The money is / already moving." />
      <div class="pad"><SpendCounter perSecond={SPEND.perSecond} client:visible /></div>
    </div>
  </section>
</Base>

<style>
  .panel { padding-block: clamp(var(--s-8), 11vh, var(--s-10)); position: relative; }

  .panel--hero {
    min-height: min(90svh, 52rem);
    display: grid;
    align-items: center;
    background: linear-gradient(180deg, #fdfcfa 0%, #fbf8f2 42%, #f6ece0 74%, #efdfcd 100%);
  }

  .panel--hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent) 18%, var(--accent) 82%, transparent);
    opacity: 0.4;
  }

  .panel--tight { padding-block: clamp(var(--s-7), 8vh, var(--s-9)); background: var(--paper); }
  .panel--tint { background: var(--paper-2); }
  .panel--open { background: var(--paper); }

  .panel--deep { background: var(--deep); color: var(--on-deep); }
  .panel--deep :is(h1, h2) { color: var(--on-deep); }

  .panel--ask { background: var(--accent-soft); }

  .panel__inner { display: grid; justify-items: start; }

  .ctarow { margin-block-start: var(--s-7); }

  /* ─────────── scan layer ─────────── */

  .brand {
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--s-6);
  }

  .kick {
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-block-end: var(--s-5);
  }
  .kick--deep { color: var(--on-deep-2); }

  /* Grotesque, tracked tight and led under 1.0 — verified clear of glyph
     collision by measuring ink extents rather than font boxes. */
  .mega {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.75rem, 8.8vw, 7.5rem);
    line-height: 0.97;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .mega--sm { font-size: clamp(2.25rem, 6.2vw, 4.75rem); }

  .mega--ask {
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    max-width: 15ch;
    margin-block-start: var(--s-9);
  }
  .mega--ask em { font-style: italic; color: var(--accent); }

  .under {
    font-size: var(--t-lede);
    color: var(--ink-2);
    max-width: 46ch;
    margin-block-start: var(--s-6);
  }
  .under--deep { color: var(--on-deep-2); }

  /* ─────────── receipt ─────────── */

  .receipt {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    column-gap: var(--s-8);
    border-block-start: 1px solid var(--rule-strong);
  }

  .receipt__row {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--rule);
    transition-delay: var(--d);
  }

  .receipt__item {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .receipt__leader {
    flex: 1;
    height: 1px;
    background-image: radial-gradient(circle, var(--rule-strong) 1px, transparent 1px);
    background-size: 6px 1px;
    background-repeat: repeat-x;
    align-self: center;
    min-width: var(--s-5);
  }

  .receipt__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .receipt__unit {
    font-size: var(--t-micro);
    color: var(--ink-3);
    white-space: nowrap;
    min-width: 6.5rem;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .receipt__where { color: var(--ink-4); font-size: 0.625rem; }

  .receipt__tag {
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-4);
    white-space: nowrap;
  }

  .turn {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5.2vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: 3px double var(--ink);
    max-width: 18ch;
  }
  .turn em { font-style: italic; color: var(--accent); }

  /* ─────────── your share ─────────── */

  .stake {
    list-style: none;
    padding: 0;
    width: 100%;
    margin-block-start: var(--s-8);
    display: grid;
    gap: 1px;
    background: var(--rule-deep);
    border-block: 1px solid var(--rule-deep);
  }

  .stake__row {
    position: relative;
    background: var(--deep);
    padding: var(--s-6) 0 var(--s-6) var(--s-5);
  }

  .stake__mark {
    position: absolute;
    inset-block: var(--s-6);
    inset-inline-start: 0;
    width: 3px;
    background: var(--mark);
  }

  .stake__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--on-deep);
  }

  .stake__label {
    font-size: var(--t-lede);
    color: var(--on-deep-2);
    margin-block-start: var(--s-3);
    max-width: 36ch;
  }

  .stake__working {
    font-size: var(--t-small);
    color: #6f7681;
    margin-block-start: var(--s-2);
    max-width: 54ch;
    line-height: 1.55;
  }

  .source--deep { color: #6f7681; margin-block-start: var(--s-5); }

  /* ─────────── authority ─────────── */

  .auth {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-6);
    display: grid;
    gap: var(--s-3);
    max-width: 52ch;
  }

  .auth li {
    padding-inline-start: var(--s-5);
    position: relative;
    color: var(--ink-2);
  }

  .auth li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    width: 10px;
    height: 2px;
    background: var(--accent);
  }

  .auth strong { color: var(--ink); font-weight: 600; }

  /* ─────────── ledgers ─────────── */

  .ledgers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    gap: var(--s-8);
    margin-block-start: var(--s-7);
  }


  /* ─────────── hero band ─────────── */

  .hero__band { margin-block-start: var(--s-8); }

  /* ─────────── pinned column ───────────
     On a wide screen the heading holds in place while the three figures
     move past it, so the claim stays on screen with its evidence. Below
     that it is simply stacked. */

  .pinwrap {
    display: grid;
    gap: var(--s-7);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .pinwrap { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--s-9); }
    .pinwrap__side {
      position: sticky;
      top: calc(3.5rem + var(--s-7));
    }
  }

  .stake--flow { margin-block-start: 0; }

  @media (max-width: 30rem) {
    .receipt__item { font-size: 1.35rem; }
    .receipt__row { padding-block: var(--s-3); }
    .receipt__unit { min-width: 0; }
    .stake__row { padding-block: var(--s-4); }
    .stake__value { font-size: 2rem; }
    .stake__label { font-size: var(--t-body); }
    .stake__working { font-size: var(--t-micro); }
  }

  .pad { margin-block-start: var(--s-7); }
  .pad-sm { margin-block-start: var(--s-6); }
</style>
