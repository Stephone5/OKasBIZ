---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props as Props;
---

<div class="head reveal">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</div>

<style>
  .head { max-width: var(--measure); }
  .head > * + * { margin-block-start: var(--s-3); }
  .head h2 { margin-block-start: var(--s-2); }
</style>
