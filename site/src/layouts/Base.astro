---
import { ClientRouter } from 'astro:transitions';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Feedback from '../components/Feedback.svelte';

// Carried over from the previous site so search engines keep the same
// description of what this is.
const SCHEMA = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Oklahoma Inc.',
  url: 'https://oklahomaasabusiness.com',
  description:
    'An integrated financial and economic atlas of Oklahoma — state finances, GDP, households, and civic opportunity presented objectively and translated to human scale for every Oklahoman.',
  about: {
    '@type': 'AdministrativeArea',
    name: 'Oklahoma',
    containedInPlace: { '@type': 'Country', name: 'United States' },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Oklahoma Inc.',
    url: 'https://oklahomaasabusiness.com',
  },
};

interface Props {
  title: string;
  description: string;
  sources?: string[];                    // source ids used by this page
  notes?: { title: string; text: string }[];
  image?: string;                        // page banner
  imageAlt?: string;
}

const { title, description, sources, notes, image, imageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#16181c" />
    <meta name="theme-color" content="#fbfaf7" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Inter:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(SCHEMA)} is:inline />

    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>
    <Nav />
    <main id="main">
      {image && (
        <figure class="banner">
          <img src={image} alt={imageAlt ?? ''} width="1400" height="860" fetchpriority="high" />
        </figure>
      )}
      <slot />
    </main>
    <Footer sources={sources} notes={notes} />
    <Feedback client:idle />

    <script>
      // One shared entrance observer. Re-armed after every view transition
      // so navigated-to pages animate the same way a first load does.
      //
      // The .js-reveal class is what switches on the hidden starting state.
      // It is only ever added here, so if this script never runs the content
      // simply stays visible.
      const arm = () => {
        document.documentElement.classList.add('js-reveal');

        // Word-by-word headline reveal. Same progressive rule as the fade:
        // the masked start state only switches on here, so without script
        // the headline just reads.
        document.documentElement.classList.add('js-split');
        const splits = document.querySelectorAll('[data-split]:not(.is-in)');
        if (splits.length) {
          if (document.visibilityState !== 'visible') {
            splits.forEach((el) => el.classList.add('is-in'));
          } else {
            const so = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting) return;
                  entry.target.classList.add('is-in');
                  so.unobserve(entry.target);
                });
              },
              { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
            );
            splits.forEach((el) => so.observe(el));
          }
        }

        const targets = document.querySelectorAll('.reveal:not(.is-in)');
        if (!targets.length) return;

        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          targets.forEach((el) => el.classList.add('is-in'));
          return;
        }

        // A hidden document never fires IntersectionObserver. Reveal
        // everything rather than leave the page blank, and let the normal
        // path take over once it becomes visible.
        if (document.visibilityState !== 'visible') {
          targets.forEach((el) => el.classList.add('is-in'));
          document.addEventListener('visibilitychange', arm, { once: true });
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => io.observe(el));
      };

      arm();
      document.addEventListener('astro:page-load', arm);
    </script>
  </body>
</html>
